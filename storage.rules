rules_version = '2';

/* ============================================================
   GEMuの静かな読書会 ― Storage のきまり

   ⚠️ 置くのは**出来上がったアバターの絵**（avatars/{uid}/{版}/。書くのは functions だけ。読めるのはログインした人だけ）と、
      **X に投稿する読書の絵**（shares/{uid}/。本人が画面から書く。X が読むので、だれでも読める。
      1週間で消える＝functions の cleanShares）。
   ⚠️⚠️ **元の写真は置かない。**アバターを作るために OpenAI へ送るだけで、どこにも残さない。
   ============================================================ */
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /shares/{uid}/{file} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }
    match /{rest=**} { allow read, write: if false; }
  }
}
