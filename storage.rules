rules_version = '2';

/* ============================================================
   GEMu 読書会 ― Storage のきまり

   ⚠️ 置くのは**出来上がったアバターの絵だけ。**書くのは裏の処理（functions）だけ。
   ⚠️⚠️ **元の写真は置かない。**アバターを作るために OpenAI へ送るだけで、どこにも残さない。
   ⚠️ 読めるのはログインしたひとだけ。
   ============================================================ */
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{rest=**} { allow read, write: if false; }
  }
}
