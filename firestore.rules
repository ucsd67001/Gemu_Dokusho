rules_version = '2';

/* ============================================================
   GEMu 読書会 ― Firestore のきまり

   ⚠️ **Google でログインした人は、だれでもその場で登録できる**（Hongaeshi と同じ。2026-09-27 配信者の決定）。
      初めは招待制にしていたが、やめた。料金の歯止めは functions の回数の上限（1人1日・全員1日）で持つ。

   ⚠️ 名前は ASCII（Hongaeshi と同じ。ルールの言語が日本語の識別子を受け付けない）。
      翻訳しているのは public/土台.js だけ。

        users/{uid}          { name, created, flip, avatar{ status, step, sit, turn, face, facing, error, at, day, count } }
        rooms/{room}/seats/{席番号}  { uid, title, since, seen }
        logs/{id}            { uid, room, title, from, to }   ← 「読み終える」で終えたときだけ書く
        meta/usage           { day, count }   ← functions だけが書く（アバターを作った回数・全員ぶん）
        books/{id}           { title, author, publisher, isbn, note, status, requestedBy, created, decided }
                             ← 本。status は pending（仮登録）／approved（本登録）／rejected（見送り）
        admins/{uid}         { }  ← 管理者。**Firebase コンソールで足す**（リポジトリにメールや uid を書かない）
        finishes/{id}        { uid, title, pages, at }   ← 「読み終える」で読了の印を付けたとき。本人だけ読める
        shares/{id}          { uid, title, minutes, place, image, created }  ← 読み終えて X に投稿したときの記録。だれでも読める

   ⚠️ avatar は**裏の処理（functions）だけが書く。**画面からは name と flip（向きを反対にする）しか変えられない。
   ⚠️ 表示名を席や記録に焼き付けない。uid だけ持ち、画面で users から引く。
   ============================================================ */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) { return request.auth.uid == uid; }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function validTitle(t) { return t is string && t.size() >= 1 && t.size() <= 120; }
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function shortText(t, n) { return t is string && t.size() <= n; }

    // 自分が管理者かだけは、本人が確かめられる
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    /* 本（2026-09-29 配信者）。入室のときに選ぶ。無ければ利用者が申請して**仮登録**（pending）。
       **管理者が承認して本登録**（approved）。仮登録の本は、申請した本人と管理者だけが読める
       （申請した本人は、仮登録のままその題でベンチに座れる） */
    match /books/{id} {
      allow read: if signedIn()
        && (resource.data.status == 'approved' || resource.data.requestedBy == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'author', 'publisher', 'isbn', 'note', 'pages', 'status', 'requestedBy', 'created'])
        && (!('pages' in request.resource.data) || (request.resource.data.pages is int
            && request.resource.data.pages >= 0 && request.resource.data.pages <= 20000))
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid
        && validTitle(request.resource.data.title)
        && request.resource.data.author is string && request.resource.data.author.size() >= 1 && request.resource.data.author.size() <= 80
        && request.resource.data.publisher is string && request.resource.data.publisher.size() >= 1 && request.resource.data.publisher.size() <= 80
        && shortText(request.resource.data.isbn, 20)
        && shortText(request.resource.data.note, 300)
        && request.resource.data.created == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'title', 'author', 'publisher', 'isbn', 'pages', 'decided'])
        && request.resource.data.status in ['approved', 'rejected']
        && validTitle(request.resource.data.title);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'created'])
        && validName(request.resource.data.name)
        && request.resource.data.created == request.time;
      allow update: if signedIn() && isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'flip'])
        && validName(request.resource.data.name)
        && (!('flip' in request.resource.data) || request.resource.data.flip is bool);
    }

    /* 席。文書の id が席の番号。
       ⚠️ seen（最後に生きていた時刻）が3分より古い席は、空いているとみなす。
          タブを閉じると「立つ」が届かないことがあるため。空いた席には誰でも座れる。 */
    match /rooms/{room}/seats/{seat} {
      // 12時間（画面を消して読む人のため。2026-10-04。土台.js の 古いとみなす とそろえる）
      function stale() { return resource.data.seen < request.time - duration.value(12, 'h'); }
      function shape() {
        return request.resource.data.keys().hasOnly(['uid', 'title', 'since', 'seen', 'book'])   // book＝本の id（別の端末が本を引き継ぐため）
          && request.resource.data.uid == request.auth.uid
          && shortText(request.resource.data.title, 120)   // 空＝題を名札に出さない
          && request.resource.data.seen == request.time
          && request.resource.data.since is timestamp
          && request.resource.data.since <= request.time;
      }
      allow read: if signedIn();
      // ⚠️ 場所を増やしたら、ここにも足す（public/部屋.js の id と同じ名前）
      allow create: if signedIn() && room in ['rothenburg', 'owakudani', 'ashinoko', 'cafe']
        && seat in ['0', '1', '2', '3', '4', '5', '6', '7'] && shape();   // 8人まで（ローテンブルク）
      allow update: if signedIn() && shape() && (resource.data.uid == request.auth.uid || stale());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || stale());
    }

    /* 読んだ時間の記録。**「読み終える」で終えたときだけ**、画面が区切りごとに1件ずつ書く（2026-09-29 配信者）。
       from/to は画面の時計（本を替えた区切りの時刻）。あとから直さない（update は無い）。
       ⚠️ 読めるのは本人だけ（前は、ログインした人ならだれの記録でも読めた） */
    match /logs/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'room', 'title', 'from', 'to', 'book'])
        && request.resource.data.uid == request.auth.uid
        && validTitle(request.resource.data.title)
        && request.resource.data.room is string
        && request.resource.data.from is timestamp
        && request.resource.data.to is timestamp
        && request.resource.data.from <= request.resource.data.to
        && request.resource.data.to <= request.time + duration.value(5, 'm')
        && request.resource.data.from >= request.time - duration.value(2, 'd');
    }

    /* 読了（2026-09-29 配信者）。「読み終える」で「この本を最後まで読んだ」に印を付けたときに1件。
       pages はその本の総ページ数（入れなければ 0）。冊数とページ数を数えるため（functions の readerStats）。
       ⚠️ 読めるのは本人だけ。全員分の上位3人は readerStats が数えて返す */
    match /finishes/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'title', 'pages', 'at', 'book'])
        && request.resource.data.uid == request.auth.uid
        && validTitle(request.resource.data.title)
        && request.resource.data.pages is int
        && request.resource.data.pages >= 0 && request.resource.data.pages <= 20000
        && request.resource.data.at == request.time;
    }

    /* X に投稿した読書の記録。記録ページ（functions の sharePage）が読む。
       ⚠️ だれでも読める（X がリンクを開くため）。名前は入れない。書名・分・場所・絵だけ */
    match /shares/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'title', 'minutes', 'place', 'image', 'created'])
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.title, 120)   // 空＝題を出さずに読んだ
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= 0 && request.resource.data.minutes < 1440
        && request.resource.data.place is string && request.resource.data.place.size() <= 40
        && request.resource.data.image is string
        && request.resource.data.image.matches('https://firebasestorage[.]googleapis[.]com/.*')
        && request.resource.data.created == request.time;
    }

    match /{rest=**} { allow read, write: if false; }
  }
}
