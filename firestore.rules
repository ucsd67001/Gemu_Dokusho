rules_version = '2';

/* ============================================================
   GEMu 読書会 ― Firestore のきまり

   ⚠️ **Google でログインした人は、だれでもその場で登録できる**（Hongaeshi と同じ。2026-09-27 配信者の決定）。
      初めは招待制にしていたが、やめた。料金の歯止めは functions の回数の上限（1人1日・全員1日）で持つ。

   ⚠️ 名前は ASCII（Hongaeshi と同じ。ルールの言語が日本語の識別子を受け付けない）。
      翻訳しているのは public/土台.js だけ。

        users/{uid}          { name, created, flip, avatar{ status, step, sit, turn, face, facing, error, at, day, count } }
        rooms/{room}/seats/{席番号}  { uid, title, since, seen }
        logs/{id}            { uid, room, title, from, to }
        meta/usage           { day, count }   ← functions だけが書く（アバターを作った回数・全員ぶん）

   ⚠️ avatar は**裏の処理（functions）だけが書く。**画面からは name と flip（向きを反対にする）しか変えられない。
   ⚠️ 表示名を席や記録に焼き付けない。uid だけ持ち、画面で users から引く。
   ============================================================ */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) { return request.auth.uid == uid; }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function validTitle(t) { return t is string && t.size() >= 1 && t.size() <= 120; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'created'])
        && validName(request.resource.data.name)
        && request.resource.data.created == request.time;
      allow update: if signedIn() && isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'flip'])
        && validName(request.resource.data.name)
        && (!('flip' in request.resource.data) || request.resource.data.flip is bool);
    }

    /* 席。文書の id が席の番号。
       ⚠️ seen（最後に生きていた時刻）が3分より古い席は、空いているとみなす。
          タブを閉じると「立つ」が届かないことがあるため。空いた席には誰でも座れる。 */
    match /rooms/{room}/seats/{seat} {
      function stale() { return resource.data.seen < request.time - duration.value(3, 'm'); }
      function shape() {
        return request.resource.data.keys().hasOnly(['uid', 'title', 'since', 'seen'])
          && request.resource.data.uid == request.auth.uid
          && validTitle(request.resource.data.title)
          && request.resource.data.seen == request.time
          && request.resource.data.since is timestamp
          && request.resource.data.since <= request.time;
      }
      allow read: if signedIn();
      // ⚠️ 場所を増やしたら、ここにも足す（public/部屋.js の id と同じ名前）
      allow create: if signedIn() && room in ['rothenburg', 'cafe']
        && seat in ['0', '1', '2', '3', '4', '5', '6', '7'] && shape();   // 8人まで（ローテンブルク）
      allow update: if signedIn() && shape() && (resource.data.uid == request.auth.uid || stale());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || stale());
    }

    /* 読んだ時間の記録。入室で作り、1分ごとに to を延ばす。
       ⚠️ 立つときに書くだけだと、タブを閉じた回が記録に残らない。 */
    match /logs/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'room', 'title', 'from', 'to'])
        && request.resource.data.uid == request.auth.uid
        && validTitle(request.resource.data.title)
        && request.resource.data.room is string
        && request.resource.data.from == request.time
        && request.resource.data.to == request.time;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to'])
        && request.resource.data.to == request.time;
    }

    match /{rest=**} { allow read, write: if false; }
  }
}
